groups:
  - name: system_alerts
    rules:
      - alert: HighCPUUsage
        expr: 100 - (avg by(instance)(rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
        for: 2m
        labels:
          severity: warning
        annotations:
          description: "CPU usage is above 80% for 2 minutes on {{ $labels.instance }}"

      - alert: HighMemoryUsage
        expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 85
        for: 2m
        labels:
          severity: critical
        annotations:
          description: "Memory usage above 85% on {{ $labels.instance }}"

      - alert: HighErrorRate
        expr: rate(app_errors_total[5m]) / rate(app_requests_total[5m]) * 100 > 10
        for: 1m
        labels:
          severity: critical
        annotations:
          description: "App error rate above 10% — check application logs"

      - alert: AppDown
        expr: up{job="sample_app"} == 0
        for: 30s
        labels:
          severity: critical
        annotations:
          description: "Sample application is down!"
